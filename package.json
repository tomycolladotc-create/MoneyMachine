{
  "name": "panel-cedears",
  "productName": "Panel CEDEARs",
  "version": "0.4.0",
  "description": "Dashboard de escritorio para analisis de CEDEARs argentinos con datos en vivo de Yahoo Finance",
  "main": "src/main/main.js",
  "author": "Tomy Collado",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tomycollado.panelcedears",
    "productName": "Panel CEDEARs",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
